# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/smartcampus
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartcampus?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smartcampus

# JWT Configuration
JWT_SECRET=smartcampus_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Firebase Admin Service Account (Optional if serviceAccountKey.json is in backend/config/)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
