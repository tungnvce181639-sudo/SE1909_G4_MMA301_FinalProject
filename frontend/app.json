{
  "expo": {
    "name": "SmartCampus Market",
    "slug": "smartcampus-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "android": {
      "package": "com.tungnv123.smartcampusmarket"
    },
    "extra": {
      "eas": {
        "projectId": "fc576d93-d791-4bc1-8c9d-7232628fe67e"
      }
    },
    "owner": "ducnqces-team"
  }
}
